# Old config.guess isn't arm64-aware. Pull a new one in from automake or GNU.
build_package_freshen_automake_config() {
  {
    if type -p brew >/dev/null; then
      brew install automake
      cp `brew --prefix automake`/share/automake-*/config.{guess,sub} tool/
    elif [ -d /usr/share/automake-* ]; then
      cp /usr/share/automake-*/config.{guess,sub} tool/
    else
      # Download directly from GNU Savannah
      curl -fsSL -o tool/config.guess 'https://git.savannah.gnu.org/gitweb/?p=config.git;a=blob_plain;f=config.guess;hb=HEAD'
      curl -fsSL -o tool/config.sub 'https://git.savannah.gnu.org/gitweb/?p=config.git;a=blob_plain;f=config.sub;hb=HEAD'
      chmod +x tool/config.{guess,sub}
    fi
  } >&4 2>&1
}

# Regexp compiler fixes backported from upstream Onigmo. Both are reachable from any
# pattern a user can get into Regexp.new, and this Ruby is too old to ever get them from a
# release. Quoted heredocs, because the first patch has a backslash line continuation that
# an unquoted one would eat. --fuzz=0 so a patch that stops matching fails the build rather
# than landing somewhere nearby; test/build asserts both fixes against the installed Ruby.
#
# https://github.com/ruby/ruby/pull/19020: nested bounded repeats overflow the int product
# that decides whether to unroll a repeat inline, so Regexp.new("(?:.{90000,}){90000}")
# starts unrolling an enormous program and never returns. Ruby only acts on a signal once
# the C call returns, so SIGTERM doesn't stop it either. The product is compared by
# division instead, and the program size is capped as it's emitted.
build_package_patch_regexp_program_size_overflow() {
  patch -p1 --fuzz=0 --force >&4 2>&1 <<'EOF'
--- a/include/ruby/oniguruma.h
+++ b/include/ruby/oniguruma.h
@@ -554,6 +554,7 @@
 #define ONIGERR_NEVER_ENDING_RECURSION                       -221
 #define ONIGERR_GROUP_NUMBER_OVER_FOR_CAPTURE_HISTORY        -222
 #define ONIGERR_INVALID_CHAR_PROPERTY_NAME                   -223
+#define ONIGERR_TOO_BIG_COMPILED_PROGRAM                     -226
 #define ONIGERR_INVALID_CODE_POINT_VALUE                     -400
 #define ONIGERR_INVALID_WIDE_CHAR_VALUE                      -400
 #define ONIGERR_TOO_BIG_WIDE_CHAR_VALUE                      -401
--- a/regcomp.c
+++ b/regcomp.c
@@ -205,6 +205,10 @@
 static int
 add_opcode(regex_t* reg, int opcode)
 {
+  /* Every instruction passes here, so this is where a program that would
+     outgrow its offset type is stopped, while it is still being emitted. */
+  if (reg->used > MAX_COMPILED_PROGRAM_SIZE)
+    return ONIGERR_TOO_BIG_COMPILED_PROGRAM;
   BBUF_ADD1(reg, opcode);
   return 0;
 }
@@ -729,6 +733,10 @@
 }
 
 #define QUANTIFIER_EXPAND_LIMIT_SIZE   50
+/* (tlen * n <= QUANTIFIER_EXPAND_LIMIT_SIZE) without overflowing int: tlen
+   and n are each bounded by ONIG_MAX_REPEAT_NUM, but their product is not. */
+#define IS_EXPAND_LIMIT_OK(tlen, n) \
+  ((n) <= 0 || (tlen) <= QUANTIFIER_EXPAND_LIMIT_SIZE / (n))
 #define CKN_ON   (ckn > 0)
 
 #ifdef USE_COMBINATION_EXPLOSION_CHECK
@@ -993,7 +1001,7 @@
     mod_tlen = tlen;
 
   if (infinite &&
-      (qn->lower <= 1 || tlen * qn->lower <= QUANTIFIER_EXPAND_LIMIT_SIZE)) {
+      (qn->lower <= 1 || IS_EXPAND_LIMIT_OK(tlen, qn->lower))) {
     if (qn->lower == 1 && tlen > QUANTIFIER_EXPAND_LIMIT_SIZE) {
       len = SIZE_OP_JUMP;
     }
@@ -1016,8 +1024,8 @@
     len = SIZE_OP_JUMP + tlen;
   }
   else if (!infinite && qn->greedy &&
-           (qn->upper == 1 || (tlen + SIZE_OP_PUSH) * qn->upper
-                                      <= QUANTIFIER_EXPAND_LIMIT_SIZE)) {
+           (qn->upper == 1 ||
+            IS_EXPAND_LIMIT_OK(tlen + SIZE_OP_PUSH, qn->upper))) {
     len = tlen * qn->lower;
     len += (SIZE_OP_PUSH + tlen) * (qn->upper - qn->lower);
   }
@@ -1067,7 +1075,7 @@
     mod_tlen = tlen;
 
   if (infinite &&
-      (qn->lower <= 1 || tlen * qn->lower <= QUANTIFIER_EXPAND_LIMIT_SIZE)) {
+      (qn->lower <= 1 || IS_EXPAND_LIMIT_OK(tlen, qn->lower))) {
     if (qn->lower == 1 && tlen > QUANTIFIER_EXPAND_LIMIT_SIZE) {
       if (qn->greedy) {
 	if (IS_NOT_NULL(qn->head_exact))
@@ -1131,8 +1139,8 @@
     r = compile_tree(qn->target, reg);
   }
   else if (!infinite && qn->greedy &&
-           (qn->upper == 1 || (tlen + SIZE_OP_PUSH) * qn->upper
-                                  <= QUANTIFIER_EXPAND_LIMIT_SIZE)) {
+           (qn->upper == 1 ||
+            IS_EXPAND_LIMIT_OK(tlen + SIZE_OP_PUSH, qn->upper))) {
     int n = qn->upper - qn->lower;
 
     r = compile_tree_n_times(qn->target, qn->lower, reg);
--- a/regerror.c
+++ b/regerror.c
@@ -168,6 +168,8 @@
     p = "group number is too big for capture history"; break;
   case ONIGERR_INVALID_CHAR_PROPERTY_NAME:
     p = "invalid character property name {%n}"; break;
+  case ONIGERR_TOO_BIG_COMPILED_PROGRAM:
+    p = "too big compiled program"; break;
   case ONIGERR_NOT_SUPPORTED_ENCODING_COMBINATION:
     p = "not supported encoding combination"; break;
   case ONIGERR_INVALID_COMBINATION_OF_OPTIONS:
--- a/regint.h
+++ b/regint.h
@@ -310,6 +310,11 @@
 
 #define INT_MAX_LIMIT           ((1UL << (SIZEOF_INT * 8 - 1)) - 1)
 
+/* Program offsets are RelAddrType, and the compile_length_*() functions sum
+   into int, so a larger program would wrap both.  The quarter leaves room
+   for the sums the offset arithmetic makes out of those lengths. */
+#define MAX_COMPILED_PROGRAM_SIZE  ((unsigned int )(INT_MAX_LIMIT / 4))
+
 #define DIGITVAL(code)    ((code) - '0')
 #define ODIGITVAL(code)   DIGITVAL(code)
 #define XDIGITVAL(enc,code) \
EOF
}

# https://github.com/ruby/ruby/pull/16801 (CVE-2026-110264): more than 32,767 range repeats
# or null checks in one pattern wrap their signed 16-bit ID negative. A negative repeat ID
# indexes the match-time repeat stack, so Regexp.new("(?:foobar){0,100}" * 100000) =~ "x"
# writes out of bounds and segfaults. Both are now a RegexpError at compile time. Applies on top of the patch above, whose lines are
# part of its context.
build_package_patch_regexp_repeat_id_overflow() {
  patch -p1 --fuzz=0 --force >&4 2>&1 <<'EOF'
--- a/include/ruby/oniguruma.h
+++ b/include/ruby/oniguruma.h
@@ -554,6 +554,8 @@
 #define ONIGERR_NEVER_ENDING_RECURSION                       -221
 #define ONIGERR_GROUP_NUMBER_OVER_FOR_CAPTURE_HISTORY        -222
 #define ONIGERR_INVALID_CHAR_PROPERTY_NAME                   -223
+#define ONIGERR_TOO_MANY_RANGE_REPEAT                        -224
+#define ONIGERR_TOO_MANY_NULL_CHECK                          -225
 #define ONIGERR_TOO_BIG_COMPILED_PROGRAM                     -226
 #define ONIGERR_INVALID_CODE_POINT_VALUE                     -400
 #define ONIGERR_INVALID_WIDE_CHAR_VALUE                      -400
--- a/regcomp.c
+++ b/regcomp.c
@@ -377,6 +377,7 @@
     r = add_mem_num(reg, reg->num_null_check); /* NULL CHECK ID */
     if (r) return r;
     reg->num_null_check++;
+    if ((MemNumType)reg->num_null_check <= 0) return ONIGERR_TOO_MANY_NULL_CHECK;
   }
 
   r = compile_tree(node, reg);
@@ -697,6 +698,7 @@
   if (r) return r;
   r = add_mem_num(reg, num_repeat); /* OP_REPEAT ID */
   reg->num_repeat++;
+  if ((MemNumType)reg->num_repeat <= 0) return ONIGERR_TOO_MANY_RANGE_REPEAT;
   if (r) return r;
   r = add_rel_addr(reg, target_len + SIZE_OP_REPEAT_INC);
   if (r) return r;
--- a/regerror.c
+++ b/regerror.c
@@ -168,6 +168,10 @@
     p = "group number is too big for capture history"; break;
   case ONIGERR_INVALID_CHAR_PROPERTY_NAME:
     p = "invalid character property name {%n}"; break;
+  case ONIGERR_TOO_MANY_RANGE_REPEAT:
+    p = "too many range repeat"; break;
+  case ONIGERR_TOO_MANY_NULL_CHECK:
+    p = "too many null check"; break;
   case ONIGERR_TOO_BIG_COMPILED_PROGRAM:
     p = "too big compiled program"; break;
   case ONIGERR_NOT_SUPPORTED_ENCODING_COMBINATION:
EOF
}

install_bundler() {
  "$PREFIX_PATH"/bin/gem install bundler -v 1.17.3
}

# -O3 because leaving this empty does not mean "use configure's default". ruby-build
# exports it as CFLAGS, which supersedes configure's own optflags, so an empty value builds
# at -O0 — measured 2-3x slower than the same source at -O3.
#
# -fno-strict-overflow guards the fixnum overflow checks in these old sources, which assume
# signed overflow wraps — undefined behaviour that GCC exploits from -O2 up. On 1.8.7 its
# absence silently makes 2**64 evaluate to 0. Kept uniform across every definition here;
# it costs nothing measurable.
RUBY_CFLAGS="-O3 -fno-strict-overflow"
case "$(cc -v 2>&1)" in
  *gcc*)
    RUBY_CFLAGS+=" -Wno-discarded-qualifiers"
    RUBY_CFLAGS+=" -Wno-incompatible-pointer-types"
    RUBY_CFLAGS+=" -Wno-int-conversion"
    RUBY_CFLAGS+=" -Wno-return-type"
    # GCC 15 porting: Use -std=gnu99 with relaxed type checking
    RUBY_CFLAGS+=" -std=gnu99 -Wno-error=implicit-function-declaration"
    # Cap _FORTIFY_SOURCE at 2. Ubuntu's GCC defines it to 3 automatically whenever
    # optimization is on, and level 3's more aggressive object-size inference trips on
    # 1.9.3: the build aborts with "*** buffer overflow detected ***" while running the
    # freshly built miniruby to generate exts.mk. Level 2 builds and runs clean.
    #
    # This is not a loss of hardening relative to before. _FORTIFY_SOURCE does nothing
    # without optimization, so while this definition was (unintentionally) building at
    # -O0, no fortification was happening at all. Only 1.9.3 needs the cap; the other
    # definitions build fine at level 3.
    RUBY_CFLAGS+=" -U_FORTIFY_SOURCE -D_FORTIFY_SOURCE=2"
    ;;
  *clang*)
    RUBY_CFLAGS+=" -Wno-compound-token-split-by-macro"
    RUBY_CFLAGS+=" -Wno-implicit-function-declaration"
    RUBY_CFLAGS+=" -Wno-incompatible-function-pointer-types"
    RUBY_CFLAGS+=" -Wno-int-conversion"
    RUBY_CFLAGS+=" -Wno-return-type"
    ;;
esac
export RUBY_CFLAGS

# M1-compatible OpenSSL 1.0 from https://github.com/basecamp/homebrew-dev
if type -p brew >/dev/null; then
  brew install basecamp/dev/openssl@1.0
  package_option ruby configure --with-openssl-dir="$(brew --prefix basecamp/dev/openssl@1.0)"
else
  install_package "openssl-1.0.2u" "https://www.openssl.org/source/openssl-1.0.2u.tar.gz#ecd0c6ffb493dd06707d38b14bb4d8c2288bb7033735606569d8f90f89669d16" openssl --if needs_openssl:0.9.6-1.0.x
  package_option ruby configure --with-openssl-dir="$PREFIX_PATH/openssl"
fi

install_package "yaml-0.1.6" "http://pyyaml.org/download/libyaml/yaml-0.1.6.tar.gz#7da6971b4bd08a986dd2a61353bc422362bd0edcc67d7ebaac68c95f74182749" --if needs_yaml

# Ruby 1.9.3 has parallel make race conditions with extensions; build serially
# Export CFLAGS so configure/make pick them up
export CFLAGS="$RUBY_CFLAGS"

build_package_standard_serial() {
  local package_name="$1"
  { ./configure --prefix="$PREFIX_PATH" $RUBY_CONFIGURE_OPTS "${RUBY_CONFIGURE_OPTS_ARRAY[@]}"
    make -j1
    make install
  } >&4 2>&1
}

install_package "ruby-1.9.3-p551" "https://cache.ruby-lang.org/pub/ruby/1.9/ruby-1.9.3-p551.tar.bz2#b0c5e37e3431d58613a160504b39542ec687d473de1d4da983dabcf3c5de771e" freshen_automake_config patch_regexp_program_size_overflow patch_regexp_repeat_id_overflow standard_serial
install_bundler
